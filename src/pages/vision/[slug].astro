---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";

export const getStaticPaths = (async () => {
	const topics = await getCollection("vision");
	return topics.map((t) => ({
		params: { slug: t.slug },
		props: { entry: t },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<MainGridLayout title={d.title} description={`${d.part} - ${d.title}`}>
    <div class="flex flex-col gap-4">
        <!-- Header card -->
        <div class="card-base z-10 px-6 md:px-9 py-6 flex flex-col gap-3">
            <a href={url("/posts/robotics-vision-roadmap/")} class="text-50 hover:text-[var(--primary)] text-sm transition w-fit">
                ← 비전 학습 로드맵
            </a>

            <div class="flex items-start justify-between gap-3 flex-wrap">
                <h1 class="text-2xl md:text-3xl font-bold leading-tight">
                    <span class="text-[var(--primary)]">#{d.order}</span>
                    <span class="text-90">{d.title}</span>
                </h1>
            </div>

            <p class="text-50 text-sm -mt-1">{d.part}</p>

            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-30 text-sm">
                <span>#{d.difficulty}</span>
            </div>

            {d.reference && <p class="text-50 text-sm">📚 {d.reference}</p>}
        </div>

        <!-- Body -->
        <div class="card-base z-10 px-6 md:px-9 py-6">
            <Markdown class="prose dark:prose-invert max-w-none">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
